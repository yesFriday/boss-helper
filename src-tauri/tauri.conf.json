{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bosshelper",
  "version": "0.1.0",
  "identifier": "com.bosshelper.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BOSS直聘智能求职助手",
        "width": 1280,
        "height": 830,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/boss_backend"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
